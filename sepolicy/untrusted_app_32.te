# Allow untrusted_app_32 to access graphics services for rendering
allow untrusted_app_32 hal_graphics_mapper_service:service_manager find;

# Allow access to sysfs_vpu for DRM/graphics operations
allow untrusted_app_32 sysfs_vpu:dir { search getattr };
allow untrusted_app_32 sysfs_vpu:file { getattr open read };

# Allow access to sysfs_gpu for graphics operations (needed for GPU rendering)
allow untrusted_app_32 sysfs_gpu:dir { search getattr };
allow untrusted_app_32 sysfs_gpu:file { getattr open read };

# Suppress audits for vendor property access (Treble compliance)
dontaudit untrusted_app_32 vendor_graphics_prop:file {open getattr read map};
dontaudit untrusted_app_32 vendor_default_prop:file {open getattr read map};
