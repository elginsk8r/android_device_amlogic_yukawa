package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "device_amlogic_yukawa_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-GPL-2.0
    default_applicable_licenses: ["device_amlogic_yukawa_license"],
}

cc_binary {
    name: "android.hardware.composer.hwc3-service.drm.meson",
    defaults: [
        "android.hardware.composer.hwc3-service.drm.defaults",
    ],
    srcs: [":drm_hwcomposer_platformmeson"],

    relative_install_path: "hw",
    vendor: true,

    vintf_fragments: [":drm_hwcomposer_vintf_manifest"],
    init_rc: [":gen-drm_hwcomposer_hwc3_init_rc_meson"],
}

genrule {
    name: "gen-drm_hwcomposer_hwc3_init_rc_meson",
    srcs: [":drm_hwcomposer_init_rc"],
    out: ["hwc3-drm.meson.rc"],
    cmd: "sed " +
        // Append .meson to the executable name:
        "-e 's%hwc3-service.drm%hwc3-service.drm.meson%' " +
        "$(in) > $(out)",
}

cc_library_shared {
    name: "gralloc.yukawa",
    relative_install_path: "hw",
    vendor: true,
    owner: "arm",

    srcs: [
        "mali_gralloc_module.cpp",
        "framebuffer_device.cpp",
        "gralloc_buffer_priv.cpp",
        "mali_gralloc_bufferaccess.cpp",
        "mali_gralloc_bufferallocation.cpp",
        "mali_gralloc_bufferdescriptor.cpp",
        "mali_gralloc_ion.cpp",
        "mali_gralloc_formats.cpp",
        "mali_gralloc_reference.cpp",
        "mali_gralloc_debug.cpp",
        "mali_gralloc_public_interface.cpp",
        "mali_gralloc_private_interface.cpp",
    ] + select(soong_config_variable("yukawa_gralloc", "vsync_backend"), {
        any @ flag_val: ["gralloc_vsync_" + flag_val + ".cpp"],
        default: ["gralloc_vsync_default.cpp"],
    }),

    shared_libs: [
        "libhardware",
        "liblog",
        "libcutils",
        "libGLESv1_CM",
        "libion",
        "libsync",
        "libutils",
    ],

    cflags: [
        "-DLOG_TAG=\"gralloc\"",
        "-DGRALLOC_LIBRARY_BUILD=1",
        "-DGRALLOC_USE_GRALLOC1_API=1",
    ] + select(soong_config_variable("ANDROID", "target_board_platform"), {
        "vexpress": [
            "-DGRALLOC_16_BITS",
        ],
        "yukawa": [
            "-DDISABLE_FRAMEBUFFER_HAL=1",
            "-DGRALLOC_USE_ION_DMA_HEAP=1",
            "-DGRALLOC_32_BITS",
            "-DGRALLOC_ARM_NO_EXTERNAL_AFBC=1",
        ],
        default: [
            "-DGRALLOC_32_BITS",
            "-DGRALLOC_FB_SWAP_RED_BLUE=1",
        ],
    }),

    product_variables: {
        platform_sdk_version: {
            cflags: ["-DPLATFORM_SDK_VERSION=%d"],
        },
    },
}
